results/paper_completion/phase1_external_baselines/fusion_reaudit_20261011/preds/
results/**/*.snapshot

# ---- LLM prior cache (regenerable via API) ----
cache/

# ---- Raw source downloads (large, regenerable; not for version control) ----
data/_raw/
data/learned_critic_datasets/

# ---- Experiment run logs (regenerable; parallel to results/) ----
experiments/results/
scripts/*.log

# ---- Jupyter ----
.ipynb_checkpoints/

